<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>⛏️ MINER & DUNGEON SLAYER 🗡️</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Noto+Sans+KR:wght@500;700;900&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
    html, body { width: 100%; height: 100%; overflow: hidden; background: #050608; color: #fff; font-family: 'Noto Sans KR', sans-serif; }
    canvas { display: block; width: 100vw; height: 100vh; }

    /* 상단 HUD */
    .hud-top {
      position: absolute; top: 16px; left: 16px; display: flex; gap: 10px; z-index: 10; flex-wrap: wrap; max-width: 60vw;
    }
    .hud-card {
      background: rgba(15, 18, 28, 0.85); border: 1px solid rgba(0, 229, 255, 0.3);
      backdrop-filter: blur(10px); padding: 8px 14px; border-radius: 12px;
      display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.6);
    }
    .hud-val { font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 1rem; color: #ffcd75; }
    .hud-label { font-size: 0.6rem; color: #8a8fc0; }

    .hp-bar-mini { width: 90px; height: 8px; background: #1a1e2e; border-radius: 4px; overflow: hidden; margin-top: 2px; }
    .hp-bar-fill { height: 100%; background: linear-gradient(90deg,#22c55e,#4ade80); transition: width .15s; }
    .hp-bar-fill.low { background: linear-gradient(90deg,#ef4444,#ff8787); }

    /* 우측 제어판 (미니맵 & AUTO & 탭 전환) */
    .top-right-panel {
      position: absolute; top: 16px; right: 16px; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; z-index: 10;
    }
    .minimap-container {
      width: 110px; height: 110px; background: rgba(10, 12, 18, 0.85); border: 2px solid #2e344e; border-radius: 12px; overflow: hidden; transition: border-color .3s;
    }
    #minimapCanvas { width: 100%; height: 100%; }

    .btn-group { display: flex; gap: 6px; }
    .nav-btn {
      padding: 8px 14px; background: #1a1e2e; border: 1px solid #3d4668; border-radius: 8px; color: #fff;
      font-family: 'Orbitron'; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .nav-btn:hover { filter: brightness(1.2); }
    .nav-btn.active { background: #ff3366; border-color: #ff3366; box-shadow: 0 0 12px rgba(255, 51, 102, 0.5); }
    .auto-btn.active { background: #00e5ff; color: #000; border-color: #00e5ff; box-shadow: 0 0 12px rgba(0, 229, 255, 0.5); }
    .mute-btn { padding: 8px 10px; }

    /* 하단 무기/곡괭이 상점 및 업그레이드 트레이 */
    .upgrade-bar {
      position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
      background: rgba(12, 14, 22, 0.92); border: 1px solid rgba(255, 205, 117, 0.3); backdrop-filter: blur(12px);
      padding: 8px 14px; border-radius: 16px; display: flex; gap: 8px; z-index: 10; max-width: 95vw; overflow-x: auto;
    }
    .up-card {
      background: #161926; border: 1px solid #282d42; border-radius: 10px; padding: 6px 10px; min-width: 108px;
      display: flex; flex-direction: column; align-items: center; gap: 3px; transition: transform .15s;
    }
    .up-card.can-buy { border-color: #ffcd75; background: #22273a; }
    .up-card.can-buy:hover { transform: translateY(-3px); }
    .up-title { font-size: 0.68rem; font-weight: 700; color: #a0a5c0; text-align: center; }
    .up-lvl { font-family: 'Orbitron', sans-serif; font-size: 0.75rem; color: #ffcd75; font-weight: 800; }
    .up-desc { font-size: 0.58rem; color: #6b7094; }
    .up-btn {
      width: 100%; margin-top: 2px; padding: 4px; background: #252a3f; border: none; border-radius: 6px;
      color: #fff; font-family: 'Orbitron'; font-size: 0.65rem; font-weight: 700; cursor: pointer;
    }
    .up-card.can-buy .up-btn { background: #ffcd75; color: #000; }
    .up-btn:disabled { opacity: .5; cursor: default; }

    /* 보스 체력바 HUD */
    .boss-hud {
      position: absolute; top: 75px; left: 50%; transform: translateX(-50%);
      width: 60%; max-width: 480px; background: rgba(0,0,0,0.8); border: 2px solid #ff3366; border-radius: 10px; padding: 8px;
      display: none; flex-direction: column; align-items: center; z-index: 10;
    }
    .boss-hp-bar { width: 100%; height: 14px; background: #222; border-radius: 6px; overflow: hidden; margin-top: 4px; }
    .boss-hp-fill { width: 100%; height: 100%; background: linear-gradient(90deg, #ff0055, #ff5500); transition: width 0.1s; }

    /* 토스트 (레벨업/웨이브/깊이 알림) */
    #toastLayer { position: absolute; top: 22%; left: 50%; transform: translateX(-50%); z-index: 20; display: flex; flex-direction: column; align-items: center; gap: 6px; pointer-events: none; }
    .toast {
      font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 1.1rem; padding: 10px 22px; border-radius: 10px;
      background: rgba(10,12,20,0.9); border: 1px solid #ffcd75; color: #ffcd75; text-shadow: 0 0 10px rgba(255,205,117,0.8);
      animation: toastPop 2.2s ease forwards;
    }
    @keyframes toastPop {
      0% { opacity: 0; transform: translateY(-14px) scale(.9); }
      12% { opacity: 1; transform: translateY(0) scale(1); }
      80% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-6px) scale(.96); }
    }

    /* 저체력 비네트 */
    #lowHpVignette {
      position: absolute; inset: 0; z-index: 6; pointer-events: none; opacity: 0;
      box-shadow: inset 0 0 160px 40px rgba(255,0,60,0.65);
      transition: opacity .2s;
    }
    #lowHpVignette.pulse { animation: hpPulse 1s ease-in-out infinite; }
    @keyframes hpPulse { 0%,100% { opacity: .35; } 50% { opacity: .75; } }

    /* 오버레이 공통 (사망/일시정지) */
    .overlay {
      position: absolute; inset: 0; background: rgba(3,4,8,0.88); z-index: 30;
      display: none; flex-direction: column; align-items: center; justify-content: center; gap: 14px; text-align: center;
    }
    .overlay h2 { font-family: 'Orbitron', sans-serif; font-size: 2rem; font-weight: 900; }
    .overlay p { color: #a0a5c0; max-width: 320px; }
    .overlay-btn {
      padding: 12px 28px; background: #ffcd75; color: #000; border: none; border-radius: 10px;
      font-family: 'Orbitron'; font-weight: 800; font-size: 0.9rem; cursor: pointer;
    }
    .overlay-btn:hover { filter: brightness(1.1); }

    /* 콤보 안내 */
    #comboHint { position: absolute; bottom: 100px; left: 16px; z-index: 10; font-family:'Orbitron'; font-size:0.7rem; color:#6b7094; }
  </style>
</head>
<body>

  <!-- 자원 HUD -->
  <div class="hud-top">
    <div class="hud-card">
      <span style="font-size: 1.1rem;">💰</span>
      <div>
        <div class="hud-label">골드</div>
        <div class="hud-val" id="goldTxt">0 G</div>
      </div>
    </div>
    <div class="hud-card">
      <span style="font-size: 1.1rem;">💎</span>
      <div>
        <div class="hud-label">마기 결정</div>
        <div class="hud-val" style="color: #a855f7;" id="gemTxt">0 개</div>
      </div>
    </div>
    <div class="hud-card">
      <span style="font-size: 1.1rem;">❤️</span>
      <div>
        <div class="hud-label">체력</div>
        <div class="hud-val" style="color: #ff4757;" id="hpTxt">100 / 100</div>
        <div class="hp-bar-mini"><div class="hp-bar-fill" id="hpBarFill"></div></div>
      </div>
    </div>
    <div class="hud-card">
      <span style="font-size: 1.1rem;">🎒</span>
      <div>
        <div class="hud-label">가방</div>
        <div class="hud-val" style="color: #00e5ff;" id="bagTxt">0 / 40</div>
      </div>
    </div>
    <div class="hud-card">
      <span style="font-size: 1.1rem;" id="depthIcon">🕳️</span>
      <div>
        <div class="hud-label" id="depthLabel">광산 깊이</div>
        <div class="hud-val" style="color: #4ade80;" id="depthTxt">B1F</div>
      </div>
    </div>
  </div>

  <!-- 보스 체력바 -->
  <div class="boss-hud" id="bossHud">
    <div style="font-family:'Orbitron'; font-weight:900; color:#ff3366; font-size:0.9rem;" id="bossName">🔥 FLAME DRAGON BOSS</div>
    <div class="boss-hp-bar"><div class="boss-hp-fill" id="bossHpFill"></div></div>
  </div>

  <!-- 토스트 레이어 -->
  <div id="toastLayer"></div>

  <!-- 저체력 비네트 -->
  <div id="lowHpVignette"></div>

  <!-- 콤보 힌트 -->
  <div id="comboHint">P : 일시정지</div>

  <!-- 우측 컨트롤 패널 -->
  <div class="top-right-panel">
    <div class="minimap-container" id="minimapWrap"><canvas id="minimapCanvas" width="110" height="110"></canvas></div>
    <div class="btn-group">
      <button class="nav-btn active" id="modeMineBtn" onclick="switchMode('mine')">⛏️ 광산</button>
      <button class="nav-btn" id="modeDungeonBtn" onclick="switchMode('dungeon')">🗡️ 던전</button>
    </div>
    <div class="btn-group">
      <button class="nav-btn auto-btn" id="autoBtn" onclick="toggleAuto()">🤖 AUTO: OFF</button>
      <button class="nav-btn mute-btn" id="muteBtn" onclick="toggleMute()">🔊</button>
    </div>
  </div>

  <!-- 하단 상점/업그레이드 -->
  <div class="upgrade-bar" id="upBar"></div>

  <!-- 사망 오버레이 -->
  <div class="overlay" id="deathOverlay">
    <h2 style="color:#ff3366;">💀 쓰러졌습니다</h2>
    <p>던전이 너무 위험했네요. 광산으로 돌아가 정비하고 다시 도전하세요.</p>
    <button class="overlay-btn" onclick="respawnPlayer()">광산으로 귀환</button>
  </div>

  <!-- 일시정지 오버레이 -->
  <div class="overlay" id="pauseOverlay">
    <h2 style="color:#00e5ff;">⏸ 일시정지</h2>
    <p>P 키를 누르거나 버튼을 눌러 계속하세요.</p>
    <button class="overlay-btn" onclick="togglePause()">계속하기</button>
  </div>

  <canvas id="gameCanvas"></canvas>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const miniCanvas = document.getElementById('minimapCanvas');
    const miniCtx = miniCanvas.getContext('2d');

    function resize() {
      const oldW = canvas.width || window.innerWidth;
      const oldH = canvas.height || window.innerHeight;
      const newW = window.innerWidth, newH = window.innerHeight;
      const sx = newW / oldW, sy = newH / oldH;

      // 기존 오브젝트들이 화면 밖으로 튀지 않도록 비율에 맞춰 재배치
      if (isFinite(sx) && isFinite(sy) && oldW > 0 && oldH > 0) {
        [...ores, ...monsters, ...drops, ...particles].forEach(o => { o.x *= sx; o.y *= sy; });
        mineSellBase.x *= sx; mineSellBase.y *= sy;
        player.x *= sx; player.y *= sy;
      }
      canvas.width = newW; canvas.height = newH;
    }
    window.addEventListener('resize', resize);

    // === 사운드 효과음 Synth ===
    let audioCtx = null;
    let isMuted = false;
    function ensureAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    function playSfx(type) {
      if (isMuted) return;
      ensureAudio();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      const now = audioCtx.currentTime;

      if (type === 'mine') {
        osc.type = 'square'; osc.frequency.setValueAtTime(140, now); osc.frequency.exponentialRampToValueAtTime(30, now + 0.08);
        gain.gain.setValueAtTime(0.18, now); gain.gain.linearRampToValueAtTime(0, now + 0.08);
        osc.start(now); osc.stop(now + 0.08);
      } else if (type === 'slash') {
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(400, now); osc.frequency.exponentialRampToValueAtTime(100, now + 0.1);
        gain.gain.setValueAtTime(0.18, now); gain.gain.linearRampToValueAtTime(0, now + 0.1);
        osc.start(now); osc.stop(now + 0.1);
      } else if (type === 'sell') {
        osc.type = 'sine'; osc.frequency.setValueAtTime(523, now); osc.frequency.setValueAtTime(659, now + 0.08);
        gain.gain.setValueAtTime(0.18, now); gain.gain.linearRampToValueAtTime(0, now + 0.2);
        osc.start(now); osc.stop(now + 0.2);
      } else if (type === 'crit') {
        osc.type = 'triangle'; osc.frequency.setValueAtTime(880, now); osc.frequency.exponentialRampToValueAtTime(1400, now + 0.1);
        gain.gain.setValueAtTime(0.15, now); gain.gain.linearRampToValueAtTime(0, now + 0.12);
        osc.start(now); osc.stop(now + 0.12);
      } else if (type === 'hurt') {
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(160, now); osc.frequency.exponentialRampToValueAtTime(60, now + 0.15);
        gain.gain.setValueAtTime(0.2, now); gain.gain.linearRampToValueAtTime(0, now + 0.15);
        osc.start(now); osc.stop(now + 0.15);
      } else if (type === 'levelup') {
        [523, 659, 784, 1047].forEach((f, i) => {
          const o2 = audioCtx.createOscillator(), g2 = audioCtx.createGain();
          o2.connect(g2); g2.connect(audioCtx.destination); o2.type = 'sine';
          const t0 = now + i * 0.09;
          o2.frequency.setValueAtTime(f, t0);
          g2.gain.setValueAtTime(0.16, t0); g2.gain.linearRampToValueAtTime(0, t0 + 0.2);
          o2.start(t0); o2.stop(t0 + 0.2);
        });
      } else if (type === 'boss') {
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(80, now); osc.frequency.exponentialRampToValueAtTime(320, now + 0.4);
        gain.gain.setValueAtTime(0.22, now); gain.gain.linearRampToValueAtTime(0, now + 0.45);
        osc.start(now); osc.stop(now + 0.45);
      }
    }
    function toggleMute() {
      isMuted = !isMuted;
      document.getElementById('muteBtn').innerText = isMuted ? '🔇' : '🔊';
    }

    // === 게임 상태 및 플레이어 데이터 ===
    let currentMode = 'mine'; // 'mine' or 'dungeon'
    let gold = 0;
    let gems = 0;
    let isAuto = false;
    let isPaused = false;
    let isDead = false;
    let screenShake = 0;
    let flashAlpha = 0;
    let mineDepth = 1;
    let totalOresMined = 0;
    let waveNumber = 1;

    const player = {
      x: canvas.width / 2 || 400, y: canvas.height / 2 || 300,
      hp: 100, maxHp: 100,
      speed: 4.5, radius: 18,
      minePower: 15, swordPower: 25,
      range: 80, critChance: 0.05,
      bagCapacity: 40, bagCurrent: 0,
      mineCooldown: 260, fightCooldown: 220,
      facing: 1,
      combo: 0, lastHitTime: 0,
      targetX: null, targetY: null,
      swingTimer: 0, swingAngle: 0, walkFrame: 0
    };

    // 중앙 광산 입구 (판매 기지)
    const mineSellBase = { x: canvas.width / 2 || 400, y: 130, radius: 65 };

    // 업그레이드 트랙
    const upgrades = {
      pickaxe:  { name: '곡괭이 강화', desc: '채굴력 +12', lvl: 1, cost: 30, mult: 1.6, icon: '⛏️', type: 'gold' },
      weapon:   { name: '검 강화',     desc: '공격력 +20', lvl: 1, cost: 50, mult: 1.7, icon: '🗡️', type: 'gold' },
      bag:      { name: '가방 확장',   desc: '용량 +25',   lvl: 1, cost: 40, mult: 1.5, icon: '🎒', type: 'gold' },
      atkspeed: { name: '연타 강화',   desc: '공속 +10%',  lvl: 1, cost: 60, mult: 1.65, icon: '⏱️', type: 'gold' },
      health:   { name: '체력 증대',   desc: '최대체력 +50', lvl: 1, cost: 20, mult: 1.8, icon: '❤️', type: 'gem' },
      crit:     { name: '행운 (CRIT)', desc: '치명타 +5%',  lvl: 0, cost: 35, mult: 2.0, icon: '⚡', type: 'gem' },
      speed:    { name: '이동 속도',   desc: '속도 +0.6',   lvl: 1, cost: 45, mult: 1.6, icon: '👟', type: 'gem' }
    };

    // 광석 구성 (깊이가 깊어질수록 희귀 광석이 등장)
    const oreTypes = [
      { name: '석탄',      color: '#334155', hp: 50,   val: 20,    radius: 20, weight: 30, minDepth: 1 },
      { name: '철',        color: '#94a3b8', hp: 140,  val: 65,    radius: 22, weight: 26, minDepth: 1 },
      { name: '금',        color: '#eab308', hp: 350,  val: 220,   radius: 25, weight: 19, minDepth: 1 },
      { name: '다이아',    color: '#06b6d4', hp: 900,  val: 650,   radius: 28, weight: 12, minDepth: 1 },
      { name: '아다만티움', color: '#a855f7', hp: 2500, val: 2000,  radius: 32, weight: 7,  minDepth: 1 },
      { name: '미스릴',    color: '#10b981', hp: 5000, val: 4200,  radius: 30, weight: 5,  minDepth: 3 },
      { name: '용의 심장', color: '#f97316', hp: 12000,val: 11000, radius: 34, weight: 3,  minDepth: 6 }
    ];

    let ores = [];
    let monsters = [];
    let particles = [];
    let damageTexts = [];
    let drops = [];
    let bgMotes = [];

    function weightedOreType() {
      const avail = oreTypes.filter(t => t.minDepth <= mineDepth);
      const total = avail.reduce((s, t) => s + t.weight, 0);
      let r = Math.random() * total;
      for (const t of avail) { if (r < t.weight) return t; r -= t.weight; }
      return avail[0];
    }
    function depthScale() { return 1 + (mineDepth - 1) * 0.12; }
    function waveMobScale() { return 1 + (waveNumber - 1) * 0.22; }
    function waveBossScale() { return 1 + (waveNumber - 1) * 0.30; }

    // 광석 초기화
    function spawnOres() {
      ores = [];
      for (let i = 0; i < 35; i++) {
        const t = weightedOreType();
        const scale = depthScale();
        const maxHp = Math.round(t.hp * scale);
        ores.push({
          x: Math.random() * (canvas.width - 120) + 60, y: Math.random() * (canvas.height - 260) + 200,
          type: t, hp: maxHp, maxHp, effVal: Math.round(t.val * scale), respawnTimer: 0
        });
      }
    }
    spawnOres();

    // 던전 몬스터 스폰 (웨이브 스케일 적용)
    function spawnMonsters() {
      monsters = [];
      const mobScale = waveMobScale();
      const mobCount = Math.min(12 + Math.floor((waveNumber - 1) / 2), 20);
      for (let i = 0; i < mobCount; i++) {
        const maxHp = Math.round(180 * mobScale);
        monsters.push({
          type: 'mob', name: '던전 고블린',
          x: Math.random() * (canvas.width - 120) + 60, y: Math.random() * (canvas.height - 260) + 200,
          hp: maxHp, maxHp, atk: Math.round(8 * mobScale), radius: 18, color: '#22c55e', respawnTimer: 0
        });
      }
      const bossScale = waveBossScale();
      const bossHp = Math.round(4000 * bossScale);
      monsters.push({
        type: 'boss', name: `🔥 FLAME DRAGON BOSS Lv.${waveNumber}`,
        x: canvas.width / 2, y: 220,
        hp: bossHp, maxHp: bossHp, atk: Math.round(22 * bossScale), radius: 48, color: '#ef4444', respawnTimer: 0
      });
    }

    function spawnBgMotes() {
      bgMotes = [];
      for (let i = 0; i < 40; i++) {
        bgMotes.push({ x: Math.random() * (canvas.width || 800), y: Math.random() * (canvas.height || 600), r: Math.random() * 1.8 + 0.4, vy: -(Math.random() * 0.3 + 0.1), a: Math.random() * 0.5 + 0.1 });
      }
    }

    // === 파티클 & 토스트 ===
    function spawnParticles(x, y, color, count, spread) {
      for (let i = 0; i < count; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = (Math.random() * (spread || 3)) + 1;
        particles.push({ x, y, vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd - 1, life: 420 + Math.random() * 200, maxLife: 600, color, size: Math.random() * 3 + 2 });
      }
    }
    function showToast(text, color) {
      const layer = document.getElementById('toastLayer');
      const div = document.createElement('div');
      div.className = 'toast'; div.style.color = color || '#ffcd75'; div.style.borderColor = color || '#ffcd75';
      div.innerText = text;
      layer.appendChild(div);
      setTimeout(() => div.remove(), 2200);
    }

    // === 입력 모듈 ===
    const keys = {};
    window.addEventListener('keydown', e => {
      keys[e.key.toLowerCase()] = true;
      if (e.key.toLowerCase() === 'p') togglePause();
    });
    window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

    canvas.addEventListener('mousedown', e => {
      if (isAuto || isPaused || isDead) return;
      ensureAudio();
      if (e.clientY < window.innerHeight - 90) {
        player.targetX = e.clientX; player.targetY = e.clientY;
      }
    });
    canvas.addEventListener('touchstart', e => {
      if (isAuto || isPaused || isDead) return;
      ensureAudio();
      const t = e.touches[0];
      if (t.clientY < window.innerHeight - 90) { player.targetX = t.clientX; player.targetY = t.clientY; }
    }, { passive: true });

    function switchMode(mode) {
      currentMode = mode;
      document.getElementById('modeMineBtn').classList.toggle('active', mode === 'mine');
      document.getElementById('modeDungeonBtn').classList.toggle('active', mode === 'dungeon');
      document.getElementById('bossHud').style.display = mode === 'dungeon' ? 'flex' : 'none';
      document.getElementById('minimapWrap').style.borderColor = mode === 'dungeon' ? '#ff3366' : '#00e5ff';
      document.getElementById('depthIcon').innerText = mode === 'dungeon' ? '🌊' : '🕳️';
      document.getElementById('depthLabel').innerText = mode === 'dungeon' ? '던전 웨이브' : '광산 깊이';
      document.getElementById('depthTxt').innerText = mode === 'dungeon' ? `WAVE ${waveNumber}` : `B${mineDepth}F`;

      player.x = canvas.width / 2; player.y = canvas.height - 150;
      player.targetX = null; player.targetY = null;

      if (mode === 'dungeon' && monsters.length === 0) spawnMonsters();
    }

    function toggleAuto() {
      isAuto = !isAuto;
      const btn = document.getElementById('autoBtn');
      btn.innerText = isAuto ? '🤖 AUTO: ON' : '🤖 AUTO: OFF';
      btn.classList.toggle('active', isAuto);
    }

    function togglePause() {
      if (isDead) return;
      isPaused = !isPaused;
      document.getElementById('pauseOverlay').style.display = isPaused ? 'flex' : 'none';
    }

    function respawnPlayer() {
      isDead = false;
      document.getElementById('deathOverlay').style.display = 'none';
      player.hp = player.maxHp;
      switchMode('mine');
    }

    function findNearest(list, cond, x, y) {
      let best = null, bestD = Infinity;
      for (const o of list) {
        if (!cond(o)) continue;
        const d = Math.hypot(o.x - x, o.y - y);
        if (d < bestD) { bestD = d; best = o; }
      }
      return best;
    }

    // === 메인 루프 업데이트 ===
    let lastAttackTime = 0;

    function update(dt) {
      const factor = dt / 16.6667; // 60fps 기준 정규화

      // 배경 먼지 파티클
      bgMotes.forEach(m => { m.y -= m.vy * factor; if (m.y < -5) m.y = canvas.height + 5; });

      if (isPaused || isDead) { updateUi(); return; }

      // 1. 플레이어 이동
      let dx = 0, dy = 0;

      if (isAuto) {
        let target = null;
        if (currentMode === 'mine') {
          target = player.bagCurrent >= player.bagCapacity ? mineSellBase : findNearest(ores, o => o.hp > 0, player.x, player.y);
        } else {
          target = findNearest(monsters, m => m.hp > 0, player.x, player.y);
        }
        if (target) {
          const tDx = target.x - player.x, tDy = target.y - player.y;
          const dist = Math.hypot(tDx, tDy);
          if (dist > 15) { dx = tDx / dist; dy = tDy / dist; }
        }
      } else {
        if (keys['w'] || keys['arrowup']) dy -= 1;
        if (keys['s'] || keys['arrowdown']) dy += 1;
        if (keys['a'] || keys['arrowleft']) dx -= 1;
        if (keys['d'] || keys['arrowright']) dx += 1;

        if (dx !== 0 || dy !== 0) {
          player.targetX = null; player.targetY = null;
          const len = Math.hypot(dx, dy); dx /= len; dy /= len;
        } else if (player.targetX !== null) {
          const tDx = player.targetX - player.x, tDy = player.targetY - player.y;
          const dist = Math.hypot(tDx, tDy);
          if (dist > 5) { dx = tDx / dist; dy = tDy / dist; }
          else { player.targetX = null; player.targetY = null; }
        }
      }

      if (dx !== 0 || dy !== 0) {
        player.x += dx * player.speed * factor; player.y += dy * player.speed * factor;
        player.walkFrame += 0.2 * factor;
        if (dx !== 0) player.facing = dx > 0 ? 1 : -1;
      }

      player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x));
      player.y = Math.max(player.radius + 60, Math.min(canvas.height - player.radius - 90, player.y));

      // 콤보 리셋 (일정 시간 공격 안 하면 초기화)
      const nowTs = Date.now();
      if (player.combo > 0 && nowTs - player.lastHitTime > 1500) player.combo = 0;

      // 2. 모드별 로직 (광산 vs 던전)
      const now = Date.now();

      if (currentMode === 'mine') {
        // 중앙 광산 입구 판매 처리
        const distToBase = Math.hypot(mineSellBase.x - player.x, mineSellBase.y - player.y);
        if (distToBase < mineSellBase.radius + player.radius && player.bagCurrent > 0) {
          gold += player.bagCurrent;
          damageTexts.push({ x: player.x, y: player.y - 20, text: `💰 +${player.bagCurrent} G 팔기 완료!`, color: '#ffcd75', alpha: 1 });
          player.bagCurrent = 0; playSfx('sell'); screenShake = 5;
        }

        // 광석 채굴
        if (player.bagCurrent < player.bagCapacity) {
          let nearest = findNearest(ores, o => o.hp > 0, player.x, player.y);
          if (nearest && Math.hypot(nearest.x - player.x, nearest.y - player.y) < player.range && now - lastAttackTime > player.mineCooldown) {
            lastAttackTime = now; player.swingTimer = 8;
            player.swingAngle = Math.atan2(nearest.y - player.y, nearest.x - player.x);

            registerHit(now);
            let isCrit = Math.random() < player.critChance;
            const comboMult = 1 + Math.min(player.combo - 1, 20) * 0.02;
            let dmg = Math.round((isCrit ? player.minePower * 2 : player.minePower) * comboMult);
            nearest.hp -= dmg; playSfx(isCrit ? 'crit' : 'mine');
            spawnParticles(nearest.x, nearest.y, nearest.type.color, isCrit ? 10 : 5, isCrit ? 4 : 2.5);

            damageTexts.push({ x: nearest.x, y: nearest.y - 15, text: isCrit ? `⚡ ${dmg}!` : `${dmg}`, color: isCrit ? '#ffcd75' : '#fff', alpha: 1 });

            if (nearest.hp <= 0) {
              screenShake = 6; nearest.respawnTimer = 7000;
              drops.push({ x: nearest.x, y: nearest.y, val: nearest.effVal, type: 'gold' });
              spawnParticles(nearest.x, nearest.y, nearest.type.color, 16, 5);
              totalOresMined++;
              if (totalOresMined % 12 === 0) {
                mineDepth++;
                document.getElementById('depthTxt').innerText = `B${mineDepth}F`;
                showToast(`⛏️ 광산 B${mineDepth}F 진입! 광석이 더 강해집니다`, '#4ade80');
                playSfx('levelup');
              }
            }
          }
        }
      } else {
        // 던전 전투 로직
        let targetMob = findNearest(monsters, m => m.hp > 0, player.x, player.y);
        if (targetMob && Math.hypot(targetMob.x - player.x, targetMob.y - player.y) < player.range && now - lastAttackTime > player.fightCooldown) {
          lastAttackTime = now; player.swingTimer = 8;
          player.swingAngle = Math.atan2(targetMob.y - player.y, targetMob.x - player.x);

          registerHit(now);
          let isCrit = Math.random() < player.critChance;
          const comboMult = 1 + Math.min(player.combo - 1, 20) * 0.02;
          let dmg = Math.round((isCrit ? player.swordPower * 2 : player.swordPower) * comboMult);
          targetMob.hp -= dmg; playSfx(isCrit ? 'crit' : 'slash');
          spawnParticles(targetMob.x, targetMob.y, isCrit ? '#ffcd75' : '#ff3366', isCrit ? 10 : 5, isCrit ? 4 : 2.5);

          damageTexts.push({ x: targetMob.x, y: targetMob.y - 15, text: isCrit ? `🔥 ${dmg}!` : `${dmg}`, color: '#ff3366', alpha: 1 });

          if (targetMob.hp <= 0) {
            if (targetMob.type === 'boss') {
              screenShake = 22; flashAlpha = 0.6; playSfx('boss');
              const bonusGold = 200 * waveNumber, bonusGems = 30 + waveNumber * 5;
              gold += bonusGold; gems += bonusGems;
              waveNumber++;
              targetMob.respawnTimer = 6000;
              showToast(`🐉 보스 처치! WAVE ${waveNumber} 시작 (+${bonusGold}G, +${bonusGems}💎)`, '#ff3366');
              document.getElementById('depthTxt').innerText = `WAVE ${waveNumber}`;
              spawnParticles(targetMob.x, targetMob.y, '#ff3366', 40, 7);
              // 모든 잔여 몹도 다음 웨이브 스탯으로 리필
              monsters.forEach(m => { if (m.type === 'mob' && m.hp <= 0) m.respawnTimer = Math.min(m.respawnTimer, 500); });
            } else {
              screenShake = 8; targetMob.respawnTimer = 8000;
              spawnParticles(targetMob.x, targetMob.y, '#22c55e', 12, 4);
            }
            drops.push({ x: targetMob.x, y: targetMob.y, val: targetMob.type === 'boss' ? 50 : 3, type: 'gem' });
          }
        }

        // 몬스터의 플레이어 공격
        monsters.forEach(m => {
          if (m.hp <= 0) return;
          const dist = Math.hypot(player.x - m.x, player.y - m.y);
          if (dist < m.radius + player.radius + 10 && Math.random() < 0.03 * factor) {
            player.hp -= m.atk; screenShake = 4; playSfx('hurt');
            damageTexts.push({ x: player.x, y: player.y - 10, text: `-${m.atk}`, color: '#ef4444', alpha: 1 });
            if (player.hp <= 0) {
              player.hp = 0; isDead = true;
              document.getElementById('deathOverlay').style.display = 'flex';
            }
          }
        });
      }

      // 광석 / 드롭템 수집 (역순 순회로 splice 스킵 버그 방지)
      for (let i = drops.length - 1; i >= 0; i--) {
        const d = drops[i];
        const dist = Math.hypot(player.x - d.x, player.y - d.y);
        if (dist < 100) {
          d.x += (player.x - d.x) * 0.15; d.y += (player.y - d.y) * 0.15;
          if (dist < player.radius + 10) {
            if (d.type === 'gold') {
              const add = Math.min(d.val, player.bagCapacity - player.bagCurrent);
              player.bagCurrent += add;
            } else { gems += d.val; }
            drops.splice(i, 1);
          }
        }
      }

      // 광석 리스폰
      ores.forEach(o => {
        if (o.hp <= 0) {
          o.respawnTimer -= dt;
          if (o.respawnTimer <= 0) {
            const scale = depthScale();
            o.maxHp = Math.round(o.type.hp * scale); o.hp = o.maxHp;
            o.effVal = Math.round(o.type.val * scale);
          }
        }
      });
      // 던전 몬스터 리스폰
      monsters.forEach(m => {
        if (m.hp <= 0) {
          m.respawnTimer -= dt;
          if (m.respawnTimer <= 0) {
            if (m.type === 'boss') {
              const s = waveBossScale();
              m.maxHp = Math.round(4000 * s); m.hp = m.maxHp; m.atk = Math.round(22 * s);
              m.name = `🔥 FLAME DRAGON BOSS Lv.${waveNumber}`;
            } else {
              const s = waveMobScale();
              m.maxHp = Math.round(180 * s); m.hp = m.maxHp; m.atk = Math.round(8 * s);
              m.x = Math.random() * (canvas.width - 120) + 60; m.y = Math.random() * (canvas.height - 260) + 200;
            }
          }
        }
      });

      // 데미지 텍스트 정제 (역순 순회)
      for (let i = damageTexts.length - 1; i >= 0; i--) {
        const dtxt = damageTexts[i];
        dtxt.y -= 1 * factor; dtxt.alpha -= 0.03 * factor;
        if (dtxt.alpha <= 0) damageTexts.splice(i, 1);
      }
      // 파티클 정제
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx * factor; p.y += p.vy * factor; p.vy += 0.12 * factor; p.life -= dt;
        if (p.life <= 0) particles.splice(i, 1);
      }

      if (screenShake > 0.05) screenShake *= Math.pow(0.85, factor); else screenShake = 0;
      if (flashAlpha > 0.01) flashAlpha *= Math.pow(0.8, factor); else flashAlpha = 0;

      updateUi();
    }

    function registerHit(now) {
      if (now - player.lastHitTime < 1500) player.combo++; else player.combo = 1;
      player.lastHitTime = now;
    }

    // === 렌더링 파이프라인 ===
    function render() {
      ctx.save();
      if (screenShake > 0.5) ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);

      // 배경 그라디언트
      const bgGrad = ctx.createRadialGradient(canvas.width / 2, canvas.height * 0.4, 40, canvas.width / 2, canvas.height * 0.4, canvas.width * 0.8);
      if (currentMode === 'mine') { bgGrad.addColorStop(0, '#101521'); bgGrad.addColorStop(1, '#05060a'); }
      else { bgGrad.addColorStop(0, '#1c0c10'); bgGrad.addColorStop(1, '#0a0507'); }
      ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 배경 먼지 파티클 (분위기)
      bgMotes.forEach(m => {
        ctx.globalAlpha = m.a;
        ctx.fillStyle = currentMode === 'mine' ? '#00e5ff' : '#ff3366';
        ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2); ctx.fill();
      });
      ctx.globalAlpha = 1;

      if (currentMode === 'mine') {
        // [중앙 광산 입구 / 판매 기지 렌더링]
        ctx.save();
        ctx.shadowColor = '#ea580c'; ctx.shadowBlur = 18;
        ctx.fillStyle = '#1c1917'; ctx.strokeStyle = '#ea580c'; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.arc(mineSellBase.x, mineSellBase.y, mineSellBase.radius, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        ctx.restore();
        ctx.fillStyle = '#ffcd75'; ctx.font = "900 14px 'Orbitron'"; ctx.textAlign = 'center';
        ctx.fillText("⛏️ 광산 입구", mineSellBase.x, mineSellBase.y - 10);
        ctx.fillStyle = '#00e5ff'; ctx.font = "700 12px 'Noto Sans KR'";
        ctx.fillText("[ 💰 광석 팔기 ]", mineSellBase.x, mineSellBase.y + 12);

        // 광석 렌더링
        ores.forEach(o => {
          if (o.hp <= 0) return;
          ctx.save();
          ctx.shadowColor = o.type.color; ctx.shadowBlur = 10;
          ctx.fillStyle = o.type.color; ctx.beginPath(); ctx.arc(o.x, o.y, o.type.radius, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
          ctx.strokeStyle = 'rgba(255,255,255,0.3)'; ctx.lineWidth = 2; ctx.stroke();
          // 체력 낮으면 살짝 균열 표시
          if (o.hp < o.maxHp * 0.4) {
            const barW = o.type.radius * 1.6;
            ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(o.x - barW / 2, o.y - o.type.radius - 10, barW, 4);
            ctx.fillStyle = '#ff5555'; ctx.fillRect(o.x - barW / 2, o.y - o.type.radius - 10, barW * Math.max(0, o.hp / o.maxHp), 4);
          }
        });
      } else {
        // 던전 몬스터 렌더링
        monsters.forEach(m => {
          if (m.hp <= 0) return;
          ctx.save();
          if (m.type === 'boss') { ctx.shadowColor = '#ff3366'; ctx.shadowBlur = 25; }
          ctx.fillStyle = m.color; ctx.beginPath(); ctx.arc(m.x, m.y, m.radius, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
          ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();

          // 체력바
          const barW = m.radius * 1.8;
          ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(m.x - barW / 2, m.y - m.radius - 12, barW, 5);
          ctx.fillStyle = m.type === 'boss' ? '#ff3366' : '#4ade80';
          ctx.fillRect(m.x - barW / 2, m.y - m.radius - 12, barW * Math.max(0, m.hp / m.maxHp), 5);

          if (m.type === 'boss') {
            document.getElementById('bossHpFill').style.width = `${Math.max(0, (m.hp / m.maxHp) * 100)}%`;
            document.getElementById('bossName').innerText = m.name;
          }
        });
        // 부활 대기중인 보스 표시
        const boss = monsters.find(m => m.type === 'boss');
        if (boss && boss.hp <= 0) {
          document.getElementById('bossHpFill').style.width = '0%';
          document.getElementById('bossName').innerText = `차원 균열 안정화 중... (${Math.ceil(boss.respawnTimer / 1000)}s)`;
        }
      }

      // 드롭 아이템 렌더링
      drops.forEach(d => {
        ctx.save();
        ctx.shadowColor = d.type === 'gold' ? '#ffcd75' : '#a855f7'; ctx.shadowBlur = 8;
        ctx.fillStyle = d.type === 'gold' ? '#ffcd75' : '#a855f7';
        ctx.beginPath(); ctx.arc(d.x, d.y, 6, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      });

      // 파티클
      particles.forEach(p => {
        ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
        ctx.fillStyle = p.color;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
      });
      ctx.globalAlpha = 1;

      // 플레이어 렌더링
      const walkY = Math.sin(player.walkFrame) * 3;
      ctx.save();
      ctx.translate(player.x, player.y + walkY);
      ctx.scale(player.facing, 1);
      ctx.fillStyle = '#ff4757'; ctx.beginPath(); ctx.arc(0, 0, player.radius, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#ffa502'; ctx.beginPath(); ctx.arc(0, -4, player.radius * 0.75, Math.PI, Math.PI * 2); ctx.fill();
      ctx.restore();

      // 무기/곡괭이 휘두르기 모션 (업그레이드 레벨에 따라 성장)
      ctx.save();
      ctx.translate(player.x, player.y + walkY);
      let angle = player.swingAngle;
      if (player.swingTimer > 0) { angle += Math.sin(player.swingTimer) * 0.8; player.swingTimer--; }
      ctx.rotate(angle);

      const lvl = currentMode === 'mine' ? upgrades.pickaxe.lvl : upgrades.weapon.lvl;
      const toolLen = 24 + Math.min(lvl * 1.4, 34);
      const glow = lvl >= 6;
      if (glow) { ctx.shadowColor = currentMode === 'mine' ? '#ffcd75' : '#ff3366'; ctx.shadowBlur = 14; }
      ctx.strokeStyle = currentMode === 'mine' ? (lvl >= 6 ? '#ffcd75' : '#8B4513') : (lvl >= 6 ? '#ff3366' : '#cbd5e1');
      ctx.lineWidth = 4 + Math.min(lvl * 0.3, 4);
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(toolLen, 0); ctx.stroke();
      ctx.restore();

      // 콤보 표시
      if (player.combo >= 3) {
        ctx.save();
        ctx.font = "900 15px 'Orbitron'"; ctx.textAlign = 'center'; ctx.fillStyle = '#ffcd75';
        ctx.shadowColor = '#ffcd75'; ctx.shadowBlur = 8;
        ctx.fillText(`${player.combo} COMBO!`, player.x, player.y - player.radius - 26);
        ctx.restore();
      }

      // 데미지 텍스트
      damageTexts.forEach(dt => {
        ctx.save(); ctx.globalAlpha = Math.max(0, dt.alpha); ctx.font = "900 14px 'Orbitron'";
        ctx.fillStyle = dt.color; ctx.textAlign = 'center'; ctx.fillText(dt.text, dt.x, dt.y); ctx.restore();
      });

      // 화면 플래시 (보스 처치 등)
      if (flashAlpha > 0.01) {
        ctx.fillStyle = `rgba(255,255,255,${flashAlpha})`;
        ctx.fillRect(-40, -40, canvas.width + 80, canvas.height + 80);
      }

      ctx.restore();
      renderMinimap();

      // 저체력 비네트
      const vg = document.getElementById('lowHpVignette');
      const lowHp = player.hp / player.maxHp < 0.3 && player.hp > 0;
      vg.style.opacity = lowHp ? '1' : '0';
      vg.classList.toggle('pulse', lowHp);
    }

    function renderMinimap() {
      miniCtx.fillStyle = '#0a0c12'; miniCtx.fillRect(0, 0, 110, 110);
      const sx = 110 / canvas.width, sy = 110 / canvas.height;

      if (currentMode === 'mine') {
        miniCtx.fillStyle = '#ea580c'; miniCtx.beginPath(); miniCtx.arc(mineSellBase.x * sx, mineSellBase.y * sy, 4, 0, Math.PI * 2); miniCtx.fill();
        ores.forEach(o => { if (o.hp > 0) { miniCtx.fillStyle = o.type.color; miniCtx.fillRect(o.x * sx, o.y * sy, 2, 2); } });
      } else {
        monsters.forEach(m => { if (m.hp > 0) { miniCtx.fillStyle = m.color; miniCtx.fillRect(m.x * sx, m.y * sy, m.type === 'boss' ? 5 : 3, m.type === 'boss' ? 5 : 3); } });
      }
      miniCtx.fillStyle = '#00e5ff'; miniCtx.beginPath(); miniCtx.arc(player.x * sx, player.y * sy, 3, 0, Math.PI * 2); miniCtx.fill();
    }

    // === UI 상점 시스템 ===
    function buyUpgrade(key) {
      const up = upgrades[key];
      const curVal = up.type === 'gold' ? gold : gems;
      if (curVal >= up.cost) {
        if (up.type === 'gold') gold -= up.cost; else gems -= up.cost;
        up.lvl++; up.cost = Math.floor(up.cost * up.mult);

        if (key === 'pickaxe') player.minePower += 12;
        if (key === 'weapon') player.swordPower += 20;
        if (key === 'bag') player.bagCapacity += 25;
        if (key === 'atkspeed') { player.mineCooldown = Math.max(90, Math.round(player.mineCooldown * 0.9)); player.fightCooldown = Math.max(80, Math.round(player.fightCooldown * 0.9)); }
        if (key === 'health') { player.maxHp += 50; player.hp = player.maxHp; }
        if (key === 'crit') player.critChance = Math.min(0.6, player.critChance + 0.05);
        if (key === 'speed') player.speed += 0.6;

        playSfx('levelup'); renderUpgradeBar(); updateUi();
        showToast(`${up.icon} ${up.name} LV.${up.lvl}!`, up.type === 'gold' ? '#ffcd75' : '#a855f7');
      }
    }

    function renderUpgradeBar() {
      const bar = document.getElementById('upBar'); bar.innerHTML = '';
      Object.keys(upgrades).forEach(key => {
        const up = upgrades[key];
        const can = (up.type === 'gold' ? gold : gems) >= up.cost;
        const card = document.createElement('div'); card.className = `up-card ${can ? 'can-buy' : ''}`;
        card.innerHTML = `
          <div class="up-title">${up.icon} ${up.name}</div>
          <div class="up-lvl">LV.${up.lvl}</div>
          <div class="up-desc">${up.desc}</div>
          <button class="up-btn" onclick="buyUpgrade('${key}')">${up.type === 'gold' ? '💰' : '💎'} ${up.cost.toLocaleString()}</button>
        `;
        bar.appendChild(card);
      });
    }

    function updateUi() {
      document.getElementById('goldTxt').innerText = `${Math.floor(gold).toLocaleString()} G`;
      document.getElementById('gemTxt').innerText = `${gems} 개`;
      document.getElementById('hpTxt').innerText = `${Math.max(0, player.hp)} / ${player.maxHp}`;
      document.getElementById('bagTxt').innerText = `${player.bagCurrent} / ${player.bagCapacity}`;
      const hpPct = Math.max(0, player.hp / player.maxHp * 100);
      const hpFill = document.getElementById('hpBarFill');
      hpFill.style.width = `${hpPct}%`;
      hpFill.classList.toggle('low', hpPct < 30);
      // 구매 가능 여부가 바뀔 수 있으니 주기적으로 버튼 상태만 가볍게 갱신
      document.querySelectorAll('.up-card').forEach((card, i) => {
        const key = Object.keys(upgrades)[i];
        const up = upgrades[key];
        const can = (up.type === 'gold' ? gold : gems) >= up.cost;
        card.classList.toggle('can-buy', can);
      });
    }

    let lastTime = performance.now();
    function gameLoop(ts) {
      const dt = Math.min(ts - lastTime, 50);
      lastTime = ts;
      update(dt);
      render();
      requestAnimationFrame(gameLoop);
    }

    resize();
    player.x = canvas.width / 2; player.y = canvas.height / 2;
    mineSellBase.x = canvas.width / 2;
    spawnOres();
    spawnBgMotes();
    renderUpgradeBar();
    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
